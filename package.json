{
  "name": "minhos-wellbe-homecare",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "description": "Well be × みんほす！ 訪問看護教育サービスLP",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "preview:local": "npm run build:site && node scripts/preview-local.mjs",
