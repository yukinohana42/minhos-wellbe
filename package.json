    "validate:release": "node scripts/validate.mjs --release",
    "export:hp": "node scripts/export-hp.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "firebase-tools": "^14.0.0",
    "sharp": "^0.35.3"
