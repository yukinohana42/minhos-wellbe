{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "origin",
    "basePath",
    "serviceId",
    "confirmedOn",
    "title",
    "heading",
    "description",
    "freeNotice",
    "operator",
    "actions",
    "analytics",
    "education",
    "occurrences",
    "voices",
    "hosts",
    "assets"
  ],
  "properties": {
    "origin": {
      "type": "string",
      "pattern": "^https://[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "basePath": {
      "type": "string",
      "pattern": "^/[a-z][a-z0-9-]*/$"
    },
    "serviceId": {
      "const": "wellbe_homecare"
    },
    "confirmedOn": {
      "$ref": "#/definitions/date"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "heading": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 35
      },
      "minItems": 1,
      "maxItems": 6
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "metaDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "freeNotice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "operator": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "contactUrl"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "contactUrl": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https://[^\\s<>]+$",
                  "maxLength": 280
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consultation",
        "registration"
      ],
      "properties": {
        "consultation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "url",
            "enabled"
          ],
          "properties": {
            "id": {
              "const": "wellbe_consult"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https://[^\\s<>]+$",
                  "maxLength": 280
                },
                {
                  "type": "null"
                }
              ]
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "url",
            "enabled",
            "occurrenceId"
          ],
          "properties": {
            "id": {
              "const": "wellbe_next_register"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https://[^\\s<>]+$",
                  "maxLength": 280
                },
                {
                  "type": "null"
                }
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "occurrenceId": {
              "anyOf": [
                {
                  "$ref": "#/definitions/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "measurementId"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "measurementId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^G-[A-Z0-9]{6,15}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "title",
        "description",
        "materialAsset"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "available"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "materialAsset": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/occurrence"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "voices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/voice"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/host"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/id"
      },
      "additionalProperties": {
        "$ref": "#/definitions/asset"
      },
      "required": [
        "wellbe-logo",
        "minhos-logo",
        "team-live",
        "home-listening",
        "physician-report",
        "new-staff"
      ],
      "properties": {
        "wellbe-logo": {
          "$ref": "#/definitions/asset"
        },
        "minhos-logo": {
          "$ref": "#/definitions/asset"
        },
        "team-live": {
          "$ref": "#/definitions/asset"
        },
        "home-listening": {
          "$ref": "#/definitions/asset"
        },
        "physician-report": {
          "$ref": "#/definitions/asset"
        },
        "new-staff": {
          "$ref": "#/definitions/asset"
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,59}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "imagePath": {
      "type": "string",
      "pattern": "^(?:study/)?assets/(?:[a-z0-9_-]+/)*[a-z0-9_-]+\\.(?:png|jpg|webp)$"
    },
    "pixels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4000
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "date",
        "startTime",
        "status",
        "number",
        "confirmedOn",
        "public",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "date": {
          "$ref": "#/definitions/date"
        },
        "startTime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "scheduled",
            "held",
            "postponed",
            "cancelled"
          ]
        },
        "number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmedOn": {
          "$ref": "#/definitions/date"
        },
        "public": {
          "type": "boolean"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurrenceId",
        "quote",
        "approved"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "occurrenceId": {
          "$ref": "#/definitions/id"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "organisation",
        "bio",
        "photo",
        "approved"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "bio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "photo": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "width",
        "height",
        "alt",
        "approved"
      ],
      "properties": {
        "src": {
          "$ref": "#/definitions/imagePath"
        },
        "width": {
          "$ref": "#/definitions/pixels"
        },
        "height": {
          "$ref": "#/definitions/pixels"
        },
        "alt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "approved": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "small": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "src",
            "width",
            "height"
          ],
          "properties": {
            "src": {
              "$ref": "#/definitions/imagePath"
            },
            "width": {
              "$ref": "#/definitions/pixels"
            },
            "height": {
              "$ref": "#/definitions/pixels"
            }
          }
        }
      }
    }
  }
}
